-- ========== 工具 ==========
local function sanitized(v, limit)
    local s = tostring(v or ''):gsub('[%z\1-\8\11\12\14-\31]', '')
    limit = limit or 2000
    return #s > limit and (s:sub(1, limit) .. '...[truncated]') or s
end

local TOOLS = {}

TOOLS.run_code = function(a)
    local compiler = loadstring or load
    if type(compiler) ~= 'function' then return 'No Luau compiler' end
    local f, e = compiler(a.code or '', '=agent')
    if not f then return 'Compile error: ' .. tostring(e) end
    local captured = {}
    local function cap(...)
        local t = table.pack(...)
        for i = 1, t.n do t[i] = tostring(t[i]) end
        table.insert(captured, table.concat(t, ' '))
    end
    pcall(function()
        local base = getfenv(f)
        setfenv(f, setmetatable({print = cap, warn = cap}, {__index = base, __newindex = base}))
    end)
    local r = table.pack(xpcall(f, debug.traceback))
    local text = table.concat(captured, '\n')
    if r[1] then
        local rets = {}
        for i = 2, r.n do
            table.insert(rets, tostring(r[i]))
        end
        local ret = table.concat(rets, ', ')
        return sanitized(
            'Success' .. (text ~= '' and ('\nOutput:\n' .. text) or '')
            .. (ret ~= '' and ('\nReturned: ' .. ret) or ''),
            5000
        )
    end
    return sanitized('Error: ' .. tostring(r[2]) .. (text ~= '' and ('\nOutput:\n' .. text) or ''), 5000)
end

TOOLS.read_file = function(a)
    if type(readfile) ~= 'function' then return 'readfile unavailable' end
    local ok, v = pcall(readfile, a.path or '')
    return ok and sanitized(v, 5000) or ('Error: ' .. tostring(v))
end

TOOLS.write_file = function(a)
    if type(writefile) ~= 'function' then return 'writefile unavailable' end
    local ok, e = pcall(writefile, a.path or '', a.content or '')
    return ok and 'File written' or ('Error: ' .. tostring(e))
end

TOOLS.list_dir = function(a)
    if type(listfiles) ~= 'function' then return 'listfiles unavailable' end
    local ok, v = pcall(listfiles, a.path or '.')
    return ok and sanitized(table.concat(v, '\n'), 5000) or ('Error: ' .. tostring(v))
end

TOOLS.search_file = function(a)
    if type(listfiles) ~= 'function' then return 'listfiles unavailable' end
    local ok, v = pcall(listfiles, a.root or '.')
    if not ok then return 'Search failed' end
    local out = {}
    local kw = tostring(a.keyword or ''):lower()
    for _, p in ipairs(v) do
        if p:lower():find(kw, 1, true) then
            table.insert(out, p)
        end
        if #out >= 30 then break end
    end
    return sanitized(table.concat(out, '\n'), 5000)
end


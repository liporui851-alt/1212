    body.AutomaticSize = Enum.AutomaticSize.Y
    body.BackgroundTransparency = 1
    body.TextWrapped = true
    body.RichText = false
    body.Font = Enum.Font.Gotham
    body.TextSize = 12
    body.TextColor3 = Color3.fromRGB(225, 228, 240)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.Text = ('[' .. title .. ']\n' .. tostring(text))
    body.Parent = row

    for _, action in ipairs(buttons or {}) do
        local button = Instance.new('TextButton')
        button.Size = UDim2.new(1, 0, 0, 26)
        button.BackgroundColor3 = Color3.fromRGB(43, 49, 66)
        button.BorderSizePixel = 0
        button.Font = Enum.Font.Gotham
        button.TextSize = 12
        button.TextColor3 = Color3.new(1, 1, 1)
        button.Text = action.Title
        button.Parent = row
        button.Activated:Connect(action.Callback)
    end

    table.insert(cards, row)
    if nearBottom then
        task.defer(function()
            task.wait()
            if scroll.Parent then
                scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y))
            end
        end)
    end
end

local function codeCard(code, token)
    local function execute()
        if token ~= session then return end
        task.spawn(function()
            local result = TOOLS.run_code({code = code})
            if token == session then card('Execution', result) end
        end)
    end

    card('Luau', code, {
        {Title = 'Copy', Icon = 'copy', Callback = function()
            local fn = setclipboard or toclipboard
            if type(fn) == 'function' then
                local ok, e = pcall(fn, code)
                notify(WindUI, ok and 'Copied' or tostring(e))
            else
                notify(WindUI, 'Clipboard unavailable')
            end
        end},
        {Title = 'Execute', Icon = 'play', Callback = execute}
    })
    if cfg.autoExecute then execute() end
end

local function finish(token, s)
    if token == session then
        running = false
        status(s or 'Ready')
    end
end

local function toolResult(name, args, token)
    if token ~= session then return false end
    local ok, res = pcall(TOOLS[name], args)
    res = ok and tostring(res) or ('Tool error: ' .. tostring(res))
    if token ~= session then return false end
    card('Tool / ' .. name, res)
    table.insert(conv, {role = 'user', content = 'Tool result (' .. name .. '): ' .. sanitized(res, 5000)})
    return true
end

pump = function(token, step)
    local ok, err = xpcall(function()
        for i = step, 15 do
            if token ~= session then return end
            status(cfg.thinking and 'Thinking...' or 'Working...')
            local snapshot = {}
            for _, m in ipairs(conv) do
                table.insert(snapshot, {role = m.role, content = m.content})
            end
            local reply, e = callAPI(snapshot)
            if token ~= session then return end
            if e then card('Error', e); finish(token, 'Failed'); return end
            if type(reply) ~= 'string' or reply == '' then
                card('Error', 'Empty reply')
                finish(token)
                return
            end
            table.insert(conv, {role = 'assistant', content = reply})
            local name, args = parseTool(reply)
            if name then
                if not TOOLS[name] then
                    card('Error', 'Unknown tool: ' .. name)
                    finish(token)
                    return
                end
                if cfg.autoExecute then
                    card('Tool request / ' .. name, HttpService:JSONEncode(args))
                    if not toolResult(name, args, token) then return end
                else
                    local item = {}
                    pending = item
                    status('Awaiting tool action')
                    card('Tool request / ' .. name, HttpService:JSONEncode(args), {
                        {Title = 'Execute', Icon = 'play', Callback = function()
                            if pending ~= item or token ~= session then return end
                            pending = nil
                            task.spawn(function()
                                if toolResult(name, args, token) then pump(token, i + 1) end
                            end)
                        end},
                        {Title = 'Reject', Icon = 'x', Callback = function()
                            if pending ~= item or token ~= session then return end
                            pending = nil
                            table.insert(conv, {role = 'user', content = 'Tool rejected. Do not retry.'})
                            task.spawn(function() pump(token, i + 1) end)
                        end}
                    })
                    return
                end
            else
                local code = reply:match('^%s*START%s*\r?\n(.-)\r?\n%s*END%s*$')
                if code then
                    codeCard(code, token)
                else
                    local fence = string.rep(string.char(96), 3)
                    local pattern = fence .. '([%w_-]*)[ \t]*\r?\n(.-)' .. fence
                    local prose = reply:gsub(pattern, '')
                    if prose:match('%S') then card('Agent', prose) end
                    for lang, body in reply:gmatch(pattern) do
                        lang = lang:lower()
                        if lang == '' or lang == 'lua' or lang == 'luau' then
                            codeCard(body, token)
                        else
                            card('Code / ' .. lang, body)
                        end
                    end
                end
                finish(token)
                return
            end
        end
        card('Agent', 'Tool limit reached (15).')
        finish(token)
    end, function(e) return tostring(e) end)
    if not ok and token == session then
        card('Error', err)
        finish(token, 'Failed')
    end
end


local function parseTool(s)
    local name = s:match('[Tt][Oo][Oo][Ll]:%s*([%w_]+)')
    local json = s:match('[Aa][Rr][Gg][Ss]:%s*(%b{})')
    if not name or not json then return nil end
    local ok, a = pcall(HttpService.JSONDecode, HttpService, json)
    if ok and type(a) == 'table' then return name, a end
end

local function callAPI(messages)
    local req = request or http_request or (syn and syn.request)
    local payload = HttpService:JSONEncode({model = cfg.model, messages = messages, temperature = .3})
    local args = {
        Url = 'https://api.deepseek.com/chat/completions',
        Method = 'POST',
        Headers = {
            ['Content-Type'] = 'application/json',
            ['Authorization'] = 'Bearer ' .. cfg.apiKey
        },
        Body = payload
    }
    local ok, res = pcall(function()
        return req and req(args) or HttpService:RequestAsync(args)
    end)
    if not ok then return nil, tostring(res) end
    if (res.StatusCode or 0) ~= 200 then
        return nil, 'HTTP ' .. tostring(res.StatusCode) .. ': ' .. sanitized(res.Body, 300)
    end
    local decodedOk, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not decodedOk or not data.choices or not data.choices[1] then
        return nil, 'Invalid API response'
    end
    return data.choices[1].message.content or ''
end

